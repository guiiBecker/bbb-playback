+# layout.json, for players that draw over the video (names, who is talking) or
+# show only a part of it: where each webcam is, whose it is, and where the
+# presentation is. Pixels of the video, seconds of the recording
+camera_users = {}
+events.xpath('/recording/event[@eventname="StartWebRTCShareEvent"]').each do |event|
+  filename = event.at_xpath('filename')&.text
+  user_id = event.at_xpath('userId')&.text
+  camera_users[File.basename(filename)] = user_id if filename && user_id
+end
+user_names = BigBlueButton::Events.user_name_map(events)
+cut_layouts_file = "#{process_dir}/video.layout.json"
+cut_layouts = File.exist?(cut_layouts_file) ? JSON.parse(File.read(cut_layouts_file)) : []
+tiles = cut_layouts.flat_map do |cut|
+  cut['tiles'].select { |tile| tile['area'] == 'webcam' }.map do |tile|
+    {
+      start: cut['start'] / 1000.0, end: cut['end'] / 1000.0,
+      x: tile['x'], y: tile['y'], width: tile['width'], height: tile['height'], border: 0,
+      user: camera_users[tile['filename']],
+    }
+  end
+end
+people = tiles.map { |tile| tile[:user] }.compact.uniq.to_h { |user| [user, { name: user_names[user].to_s }] }
+content = layout[:areas].find { |area| area[:name] == :presentation }
+File.write("#{process_dir}/layout.json", JSON.generate(
+  width: layout[:width], height: layout[:height],
+  content: content && content.slice(:x, :y, :width, :height),
+  people: people, tiles: tiles
+))
+
 logger.info "Encoding output files to #{preset['formats'].length} formats"
